#!/usr/bin/env bash
# Flutter only asks this for the Xcode version.
v=$(ls "$HOME"/.cache/xtool/darwin-*.xtoolsdk.version.plist 2>/dev/null | tail -n1)
if [ -n "$v" ]; then
  python3 -c 'import plistlib,sys; p=plistlib.load(open(sys.argv[1],"rb")); print("Xcode", p["CFBundleShortVersionString"]); print("Build version", p["ProductBuildVersion"])' "$v"
else
  echo "Xcode 27.0"; echo "Build version 27A266a"
fi
